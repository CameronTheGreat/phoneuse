<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PhoneUseMirror.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneUseMirror">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- titles in the site's voice: heavy and tight -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="-30" />
                <Setter Property="LineHeight" Value="32" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>

            <!-- pills, as the site's buttons -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,6,16,7" />
            </Style>
            <Style x:Key="BrandAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,6,16,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- a whole row as a button: Settings › Help -->
            <Style x:Key="BrandRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Settings, as drawn on phoneuse.tech's palette (the Settings Redesign canvas) -->
            <Style x:Key="BrandSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrandInk3Brush}" />
                <Setter Property="Margin" Value="4,22,4,8" />
            </Style>
            <Style x:Key="BrandRowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrandInkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BrandRowSubStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource BrandInk3Brush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="BrandCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrandCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <!-- a hairline between a card's rows -->
            <Style x:Key="BrandRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandLineBrush}" />
            </Style>
            <Style x:Key="BrandIconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource BrandPlumTintBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- stroke icons drawn on a 24-unit grid, shown at 18 (a Viewbox around a 24×24 Canvas) -->
            <Style x:Key="BrandIconPathStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource BrandPlumBrush}" />
                <Setter Property="StrokeThickness" Value="1.9" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>

            <!-- the switch: a 50×30 plum pill, a cream knob that glides (the site's ease-out) -->
            <Style x:Key="BrandSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Grid x:Name="SwitchRoot" Width="50" Height="30" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Knob.Opacity" Value="0.92" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Knob.Opacity" Value="0.85" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SwitchRoot.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualState x:Name="Dragging" />
                                        <VisualState x:Name="Off">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="On">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border CornerRadius="15" Background="#FFE6CDBB" />
                                <Border x:Name="OnTrack" CornerRadius="15" Background="{StaticResource BrandPlumBrush}" Opacity="0" />
                                <!-- the parts ToggleSwitch works with (named as in WinUI's own template): the knob
                                     travels inside SwitchKnobBounds, and SwitchThumb, an invisible Thumb over the
                                     whole switch, is what turns a click (or a drag) into a toggle; without it only
                                     the keyboard could flip the switch -->
                                <Border x:Name="SwitchKnobBounds" Margin="3,0,3,0" Background="Transparent" />
                                <Grid x:Name="SwitchKnob" Width="24" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslateTransform" />
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="Knob" Fill="{StaticResource BrandBgBrush}" Stroke="#1F3A1A2E" StrokeThickness="0.5" />
                                </Grid>
                                <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- what Settings' tabs and chips share: small bold labels, as wide as their column -->
            <Style x:Key="BrandPillChoiceStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource BrandInk2Brush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <!-- Settings' tabs: a cream track, the open one a white pill in plum -->
            <Style x:Key="BrandSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource BrandPillChoiceStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Height="36" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Pill.Opacity" Value="1" />
                                                <Setter Target="Text.Foreground" Value="{StaticResource BrandPlumBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Hover" CornerRadius="18" Background="#66FFFFFF" Opacity="0" />
                                <Border x:Name="Pill" CornerRadius="18" Background="White" BorderBrush="{StaticResource BrandLineBrush}"
                                        BorderThickness="1" Opacity="0" />
                                <ContentPresenter x:Name="Text" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- a choice among a few (the agent delay): cream pills, the chosen one plum -->
            <Style x:Key="BrandChipStyle" TargetType="RadioButton" BasedOn="{StaticResource BrandPillChoiceStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Height="36" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Base.Background" Value="{StaticResource BrandAmberTintBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Base.Background" Value="{StaticResource BrandCreamBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Fill.Opacity" Value="1" />
                                                <Setter Target="Text.Foreground" Value="{StaticResource BrandBgBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Base" CornerRadius="18" Background="{StaticResource BrandBgBrush}"
                                        BorderBrush="{StaticResource BrandLineBrush}" BorderThickness="1" />
                                <Border x:Name="Fill" CornerRadius="18" Background="{StaticResource BrandPlumBrush}" Opacity="0" />
                                <ContentPresenter x:Name="Text" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- a choice as a card row: a plum ring and dot, its title and what it means -->
            <Style x:Key="BrandRadioRowStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Stroke" Value="{StaticResource BrandPlumBrush}" />
                                                <Setter Target="Dot.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Hover" Background="#0F9A3C69" Opacity="0" />
                                <Grid Padding="14,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                                        <Ellipse x:Name="Ring" Stroke="#FFC9A996" StrokeThickness="2" />
                                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource BrandPlumBrush}" Opacity="0" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
