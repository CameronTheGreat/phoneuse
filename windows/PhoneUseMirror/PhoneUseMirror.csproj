<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phone Use's mirror window on Windows: a native WinUI 3 client of the browser
       mirror's WebSocket (phoneuse/web.py). Unpackaged and self-contained, so
       `phoneuse up` can start the .exe directly. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PhoneUseMirror</RootNamespace>
    <AssemblyName>PhoneUseMirror</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The GitHub repository whose releases update this app (Updater.cs): package.ps1 passes
         the one CI built from, so a fork's builds update from the fork. -->
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">lxe/phoneuse</UpdateRepo>
    <!-- Phone Use's version (pyproject.toml) when the build isn't given one (a plain dotnet build,
         Visual Studio): About and the updater read it. package.ps1 and build-winui.ps1 pass their own. -->
    <Version Condition="'$(Version)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\pyproject.toml')), '(?m)(?&lt;=^version\s*=\s*")[^"]+').Value)</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <!-- the phone frames' table, shared with the browser mirror (Phones.cs) -->
    <EmbeddedResource Include="..\..\phoneuse\web\phones.json" LogicalName="phones.json" Link="phones.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- WinUI and Foundation only, not the Microsoft.WindowsAppSDK metapackage: its AI, ML,
         Search and Widgets parts add ~100 MB of DLLs (ONNX Runtime, DirectML) this app never loads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>
</Project>
